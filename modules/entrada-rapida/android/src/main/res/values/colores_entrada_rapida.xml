    <color name="er_label_tertiary">#6B7480</color>
    <color name="er_label_inverse">#0D0F12</color>
    <color name="er_separator">#1E232B</color>
    <color name="er_acento">#4ADE80</color>
    <color name="er_red">#F43F5E</color>
    <color name="er_overlay">#A6000000</color>
</resources>
