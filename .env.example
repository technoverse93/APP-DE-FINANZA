# Copiar a .env y completar. El archivo .env no se versiona.
#
# Solo van aquí los valores públicos del cliente: la anon key está protegida
# por las políticas RLS. La service role key y las credenciales de correo
# NUNCA se ponen en el dispositivo; viven en Supabase Vault.

EXPO_PUBLIC_SUPABASE_URL=https://<referencia>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
