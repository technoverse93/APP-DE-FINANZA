{
  "expo": {
    "name": "Finanzas",
    "slug": "app-de-finanza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "appdefinanza",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Se usa tu biometría para desbloquear la aplicación."
      }
    },
    "android": {
      "package": "com.technoverse93.appdefinanza",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC"]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Se usa tu biometría para desbloquear la aplicación."
        }
      ],
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ece1cd9f-7350-4c33-8014-5b2b2a9c4768"
    },
    "extra": {
      "eas": {
        "projectId": "ece1cd9f-7350-4c33-8014-5b2b2a9c4768"
      }
    }
  }
}
